[
 {
  "id": "creation",
  "title": "The Days of Creation",
  "group": "Old Testament",
  "color": "#6b8e23",
  "summary": "What God made on each day of Creation week (Genesis 1–2).",
  "items": [
   {
    "t": "Day 1: Light",
    "ref": "Gen.1.3",
    "note": "\"Let there be light\"; day and night divided."
   },
   {
    "t": "Day 2: The expanse (sky)",
    "ref": "Gen.1.6",
    "note": "Waters above separated from waters below."
   },
   {
    "t": "Day 3: Land, seas and plants",
    "ref": "Gen.1.9",
    "note": "Dry land appears; vegetation and fruit trees."
   },
   {
    "t": "Day 4: Sun, moon and stars",
    "ref": "Gen.1.14",
    "note": "Lights in the heavens for signs, seasons, days and years."
   },
   {
    "t": "Day 5: Sea creatures and birds",
    "ref": "Gen.1.20",
    "note": "The waters swarm and birds fly across the sky."
   },
   {
    "t": "Day 6: Land animals and mankind",
    "ref": "Gen.1.26",
    "note": "\"Let us make man in our image\"; male and female."
   },
   {
    "t": "Day 7: God rests",
    "ref": "Gen.2.2",
    "note": "God blesses the seventh day and makes it holy."
   }
  ]
 },
 {
  "id": "plagues",
  "title": "The Ten Plagues of Egypt",
  "group": "Old Testament",
  "color": "#b5651d",
  "summary": "God's judgments on Egypt and its gods before the Exodus (Exodus 7–12).",
  "items": [
   {
    "t": "1. Water turned to blood",
    "ref": "Exod.7.20",
    "note": "The Nile turns to blood; the fish die.",
    "place": "Egypt",
    "lat": 30.1294,
    "lon": 31.3075,
    "placeIndex": 375
   },
   {
    "t": "2. Frogs",
    "ref": "Exod.8.6",
    "note": "Frogs cover the land."
   },
   {
    "t": "3. Gnats (lice)",
    "ref": "Exod.8.17",
    "note": "The magicians: \"This is the finger of God.\""
   },
   {
    "t": "4. Flies",
    "ref": "Exod.8.24",
    "note": "Swarms of flies, but none in Goshen."
   },
   {
    "t": "5. Livestock die",
    "ref": "Exod.9.6",
    "note": "Egypt's livestock die; Israel's are spared."
   },
   {
    "t": "6. Boils",
    "ref": "Exod.9.10",
    "note": "Boils break out on people and animals."
   },
   {
    "t": "7. Hail",
    "ref": "Exod.9.23",
    "note": "Thunder, hail and fire, the worst in Egypt's history."
   },
   {
    "t": "8. Locusts",
    "ref": "Exod.10.13",
    "note": "Locusts eat everything the hail left."
   },
   {
    "t": "9. Darkness",
    "ref": "Exod.10.22",
    "note": "Three days of darkness, but light where Israel lived."
   },
   {
    "t": "10. Death of the firstborn",
    "ref": "Exod.12.29",
    "note": "At midnight; the Passover lamb's blood protects Israel."
   }
  ]
 },
 {
  "id": "commandments",
  "title": "The Ten Commandments",
  "group": "Old Testament",
  "color": "#c2873b",
  "summary": "The words God spoke from Mount Sinai (Exodus 20; repeated in Deuteronomy 5).",
  "items": [
   {
    "t": "1. No other gods",
    "ref": "Exod.20.3",
    "note": "\"You shall have no other gods before me.\"",
    "place": "Mount Sinai",
    "lat": 28.5397,
    "lon": 33.9733,
    "placeIndex": 881
   },
   {
    "t": "2. No idols",
    "ref": "Exod.20.4",
    "note": "No carved image to bow down to or serve."
   },
   {
    "t": "3. Do not misuse God's name",
    "ref": "Exod.20.7",
    "note": "\"You shall not take the name of the LORD your God in vain.\""
   },
   {
    "t": "4. Keep the Sabbath holy",
    "ref": "Exod.20.8",
    "note": "Six days of work, the seventh a Sabbath to the LORD."
   },
   {
    "t": "5. Honor your father and mother",
    "ref": "Exod.20.12",
    "note": "The first commandment with a promise (Eph 6:2)."
   },
   {
    "t": "6. Do not murder",
    "ref": "Exod.20.13"
   },
   {
    "t": "7. Do not commit adultery",
    "ref": "Exod.20.14"
   },
   {
    "t": "8. Do not steal",
    "ref": "Exod.20.15"
   },
   {
    "t": "9. Do not bear false witness",
    "ref": "Exod.20.16",
    "note": "Do not lie about your neighbor."
   },
   {
    "t": "10. Do not covet",
    "ref": "Exod.20.17",
    "note": "Do not desire what belongs to your neighbor."
   }
  ]
 },
